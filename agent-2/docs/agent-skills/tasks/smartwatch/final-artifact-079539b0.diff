+  onRemoveProduct?: (productId: string) => void;
+  onClearAll?: () => void;
+  onPreviewIn3D?: (productId: string) => void;
+}
+
+function useSafeViewer() {
+  try {
+    return useViewer();
+  } catch {
+    return null;
+  }
+}
+
+export const ComparisonModal: React.FC<ComparisonModalProps> = ({
+  isOpen,
+  onClose,
+  products,
+  onRemoveProduct,
+  onClearAll,
+  onPreviewIn3D,

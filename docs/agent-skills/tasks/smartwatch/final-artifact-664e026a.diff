+              <div className="space-y-2 max-h-60 overflow-y-auto pt-2">
+                {searchResults.length > 0 ? (
+                  searchResults.map((product) => (
+                    <div
+                      key={product.id}
+                      onClick={() => {
+                        setActiveProduct(product);
+                        setIsSearchOpen(false);
+                        scrollToSection('studio');
+                      }}
+                      className="p-3 rounded-xl hover:bg-purple-50 cursor-pointer flex items-center justify-between border border-transparent hover:border-purple-200 transition-colors"
+                    >
+                      <div>
+                        <h4 className="text-sm font-bold text-slate-900">{product.name}</h4>
+                        <p className="text-xs text-slate-500">{product.tagline}</p>
+                      </div>
+                      <div className="text-right">
+                        <span className="text-sm font-extrabold text-purple-700">
+                          ${product.price}
+                        </span>
+                        <span className="text-[10px] text-cyan-600 block font-semibold">
+                          View in 3D &rarr;
+                        </span>
+                      </div>
+                    </div>
+                  ))
+                ) : (
+                  <p className="text-xs text-slate-500 text-center py-4">
+                    No matching devices found for &quot;{searchModalQuery}&quot;.
+                  </p>
+                )}
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+
+      {/* Slide-over Shopping Cart Drawer */}
+      <CartDrawer
+        isOpen={isCartOpen}
+        onClose={() => setIsCartOpen(false)}
+        onProceedToCheckout={() => {
+          setIsCartOpen(false);
+          setIsCheckoutOpen(true);
+        }}
+        items={cart.items}
+        totalItems={cart.totalItems}
+        subtotal={cart.subtotal}
+        discountCode={cart.discountCode}
+        discountAmount={cart.discountAmount}
+        tax={cart.tax}
+        shipping={cart.shipping}
+        total={cart.total}
+        onUpdateQuantity={cart.updateQuantity}
+        onRemoveItem={cart.removeItem}
+        onApplyPromoCode={cart.applyPromoCode}
+        onRemovePromoCode={cart.removePromoCode}
+      />
+
+      {/* Multi-step Simulated Checkout Modal */}
+      <CheckoutModal
+        isOpen={isCheckoutOpen}
+        onClose={() => setIsCheckoutOpen(false)}
+        onCompleteOrder={() => {
+          cart.clearCart();
+          showToast('Order confirmed! Check your email for dispatch telemetry.');
+        }}
+        items={cart.items}
+        subtotal={cart.subtotal}
+        discountCode={cart.discountCode}
+        discountAmount={cart.discountAmount}
+        tax={cart.tax}
+        shipping={cart.shipping}
+        total={cart.total}
+      />
+
+      {/* Global Footer */}
+      <Footer />
+    </div>
+  );
+};
+
+export default App;

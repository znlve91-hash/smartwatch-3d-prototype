+export type CameraPreset = 'front' | 'perspective' | 'crown' | 'profile';
+
+export interface StudioControlsProps {
+  product?: Product;
+  colors?: ColorOption[];
+  selectedColor?: ColorOption;
+  onSelectColor?: (color: ColorOption) => void;

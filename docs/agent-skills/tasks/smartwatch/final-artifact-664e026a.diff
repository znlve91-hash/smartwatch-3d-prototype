+
+afterEach(() => {
+  cleanup();
+});
+import {
+  calculateStepMetrics,
+  generateECGWave,
+  calculateBatteryEstimate,
+  celsiusToFahrenheit,
+  fahrenheitToCelsius,
+  clamp,

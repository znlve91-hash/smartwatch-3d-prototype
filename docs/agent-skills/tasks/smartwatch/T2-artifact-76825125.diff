+++ b/src/components/3d/WatchViewer3D.jsx
@@ -0,0 +1,232 @@
+/**
+ * Interactive 3D Wearable Viewport Component
+ * 360-degree Orbit, Touch Rotation, 1.5 RPM Auto-Spin, Zoom, and Dock Controls
+ * Smart Watch & Band Interactive 3D Showcase & E-Commerce Prototype
+ */
+
+import React, { useState, useRef, useCallback } from 'react';
+import { RotateCcw, ZoomIn, ZoomOut, Play, Pause, Compass, Sparkles } from 'lucide-react';
+import { use3DWatch } from '../../hooks/use3DWatch.js';
+import { ViewerControls, COLORWAYS } from './ViewerControls.jsx';
+import {
+  WIDGETS,
+  simulateNextHeartRate,
+  incrementSteps,
+  toggleMusicPlayback,
+  toggleLowPowerMode,
+} from '../../data/widgets.js';
+
+export function WatchViewer3D({
+  modelType: propModelType,
+  tier: propTier,
+  color: propColor,
+  activeFace: propFace,
+  activeWidget: propWidget,
+  widgetState: propWidgetState,
+  autoRotate: propAutoRotate,
+  showControls = true,
+  onModelChange: propOnModelChange,
+  onFaceChange: propOnFaceChange,
+  onWidgetChange: propOnWidgetChange,
+  onColorChange: propOnColorChange,
+  className = '',
+}) {
+  // Container ref for Three.js WebGL canvas mount
+  const containerRef = useRef(null);
+
+  // Controlled or uncontrolled internal states
+  const [localModelType, setLocalModelType] = useState('watch');
+  const [localTier, setLocalTier] = useState('pro');
+  const [localColor, setLocalColor] = useState(COLORWAYS[0]);
+  const [localFace, setLocalFace] = useState('minimal');
+  const [localWidget, setLocalWidget] = useState('heartRate');
+  const [localAutoRotate, setLocalAutoRotate] = useState(true);
+
+  // Initial widget states dictionary
+  const [widgetStates, setWidgetStates] = useState(() => {
+    const states = {};
+    WIDGETS.forEach((w) => {
+      states[w.id] = { ...w.initialState };
+    });
+    return states;
+  });
+
+  const activeModel = propModelType ?? localModelType;
+  const activeTier = propTier ?? localTier;
+  const activeColor = propColor ?? localColor;
+  const activeFace = propFace ?? localFace;
+  const activeWidget = propWidget ?? localWidget;
+  const autoRotate = propAutoRotate ?? localAutoRotate;
+  const currentWidgetState = propWidgetState ?? (widgetStates[activeWidget] || {});
+
+  // Handle widget simulator interactions
+  const handleWidgetAction = useCallback((widgetId) => {
+    setWidgetStates((prev) => {
+      const current = prev[widgetId] || {};
+      let updated = { ...current };
+
+      switch (widgetId) {
+        case 'heartRate':
+          updated.bpm = simulateNextHeartRate(current.bpm ?? 78);
+          break;
+        case 'steps':
+          updated = incrementSteps(current, 350);
+          break;
+        case 'weather':
+          updated.tempC = current.tempC === 24 ? 26 : 24;
+          updated.tempF = current.tempF === 75 ? 79 : 75;
+          updated.condition = current.condition === 'Partly Sunny' ? 'Clear Sky' : 'Partly Sunny';
+          break;
+        case 'music':
+          updated = toggleMusicPlayback(current);
+          break;
+        case 'battery':
+          updated = toggleLowPowerMode(current);
+          break;
+        default:
+          break;
+      }
+
+      return {
+        ...prev,
+        [widgetId]: updated,
+      };
+    });
+  }, []);
+
+  // Connect 3D rendering hook
+  const { resetView, zoomIn, zoomOut } = use3DWatch({
+    containerRef,
+    modelType: activeModel,
+    tier: activeTier,
+    chassisColor: activeColor.chassisHex || activeColor.hex || '#0F172A',
+    strapColor: activeColor.strapHex || activeColor.hex || '#1E293B',
+    accentColor: '#7C3AED',
+    faceId: activeFace,
+    widgetId: activeWidget,
+    widgetState: currentWidgetState,
+    autoRotate,
+  });
+
+  const handleToggleAutoRotate = () => {
+    setLocalAutoRotate((prev) => !prev);
+  };
+
+  const handleModelChange = (model) => {
+    if (propOnModelChange) propOnModelChange(model);
+    else setLocalModelType(model);
+  };
+
+  const handleFaceChange = (face) => {
+    if (propOnFaceChange) propOnFaceChange(face);
+    else setLocalFace(face);
+  };
+
+  const handleWidgetChange = (widget) => {
+    if (propOnWidgetChange) propOnWidgetChange(widget);
+    else setLocalWidget(widget);
+  };
+
+  const handleColorChange = (col) => {
+    if (propOnColorChange) propOnColorChange(col);
+    else setLocalColor(col);
+  };
+
+  return (
+    <div
+      className={`relative w-full h-[540px] md:h-[620px] rounded-3xl overflow-hidden bg-gradient-to-b from-[#F1EDFF] via-[#F8F6FF] to-[#EBF4FF] select-none flex flex-col justify-between ${className}`}
+      data-testid="watch-viewer-3d"
+    >
+      {/* 3D WebGL Canvas Mounting Point */}
+      <div
+        ref={containerRef}
+        className="absolute inset-0 w-full h-full cursor-grab active:cursor-grabbing touch-none"
+        title="Click and drag to rotate 360° • Scroll or pinch to zoom"
+      />
+
+      {/* Top Floating Badge & Quick Actions */}
+      <div className="relative z-10 flex items-center justify-between p-4 pointer-events-none">
+        <div className="flex items-center gap-2 bg-white/75 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/60 shadow-sm pointer-events-auto">
+          <Sparkles className="w-4 h-4 text-purple-600 animate-pulse" />
+          <span className="text-xs font-semibold text-slate-800">
+            {activeModel === 'watch' ? 'Interactive Smart Watch' : 'Interactive Smart Band'}
+          </span>
+          <span className="text-[10px] font-bold uppercase tracking-wider bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full">
+            {activeTier.replace('_', ' ')}
+          </span>
+        </div>
+
+        {/* View Controls Quick Pill */}
+        <div className="flex items-center gap-1.5 bg-white/75 backdrop-blur-md p-1 rounded-full border border-white/60 shadow-sm pointer-events-auto">
+          <button
+            type="button"
+            onClick={handleToggleAutoRotate}
+            title={autoRotate ? 'Pause 360° spin' : 'Start 360° auto-spin (1.5 RPM)'}
+            className={`p-1.5 rounded-full transition-all ${
+              autoRotate ? 'bg-purple-600 text-white' : 'text-slate-600 hover:bg-slate-100'
+            }`}
+          >
+            {autoRotate ? <Pause className="w-3.5 h-3.5" /> : <Play className="w-3.5 h-3.5" />}
+          </button>
+
+          <button
+            type="button"
+            onClick={zoomIn}
+            title="Zoom In"
+            className="p-1.5 rounded-full text-slate-600 hover:bg-slate-100 transition-all"
+          >
+            <ZoomIn className="w-3.5 h-3.5" />
+          </button>
+
+          <button
+            type="button"
+            onClick={zoomOut}
+            title="Zoom Out"
+            className="p-1.5 rounded-full text-slate-600 hover:bg-slate-100 transition-all"
+          >
+            <ZoomOut className="w-3.5 h-3.5" />
+          </button>
+
+          <button
+            type="button"
+            onClick={resetView}
+            title="Reset to Front View"
+            className="p-1.5 rounded-full text-slate-600 hover:bg-slate-100 transition-all"
+          >
+            <RotateCcw className="w-3.5 h-3.5" />
+          </button>
+        </div>
+      </div>
+
+      {/* Floating 3D Interaction Hint */}
+      <div className="relative z-10 self-center pointer-events-none mb-auto">
+        <div className="flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900/10 backdrop-blur-sm text-[11px] text-slate-600">
+          <Compass className="w-3.5 h-3.5" />
+          <span>Drag to rotate 360° • Scroll to zoom</span>
+        </div>
+      </div>
+
+      {/* Bottom Floating Controls Dock */}
+      {showControls && (
+        <div className="relative z-10 p-4 max-w-xl mx-auto w-full pointer-events-auto">
+          <ViewerControls
+            activeModel={activeModel}
+            onModelChange={handleModelChange}
+            activeFace={activeFace}
+            onFaceChange={handleFaceChange}
+            activeWidget={activeWidget}
+            onWidgetChange={handleWidgetChange}
+            onWidgetAction={handleWidgetAction}
+            selectedColor={activeColor}
+            onColorChange={handleColorChange}
+            autoRotate={autoRotate}
+            onToggleAutoRotate={handleToggleAutoRotate}
+            onResetView={resetView}
+            onZoomIn={zoomIn}
+            onZoomOut={zoomOut}
+          />
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/hooks/use3DWatch.js b/src/hooks/use3DWatch.js
new file mode 100644
index 0000000..999385a
--- /dev/null
+++ b/src/hooks/use3DWatch.js
@@ -0,0 +1,337 @@
+/**
+ * Three.js 3D Wearable Lifecycle & Render Loop Hook
+ * Smart Watch & Band Interactive 3D Showcase & E-Commerce Prototype
+ */
+
+import { useEffect, useRef, useCallback } from 'react';
+import * as THREE from 'three';
+import {
+  createWatchModel,
+  createBandModel,
+  updateModelColors,
+  disposeModel,
+} from '../components/3d/ProceduralWatchMesh.js';
+import { createWatchCanvasTexture } from '../components/3d/WatchCanvasTexture.js';
+
+// 1.5 RPM in radians per second: 1.5 * 2 * PI / 60 ≈ 0.15708 rad/s
+const AUTO_ROTATE_SPEED = (1.5 * 2 * Math.PI) / 60;
+const DEFAULT_DISTANCE = 7.0;
+const MIN_DISTANCE = 4.0;
+const MAX_DISTANCE = 11.0;
+const DAMPING = 0.08;
+
+export function use3DWatch({
+  containerRef,
+  modelType = 'watch',
+  tier = 'pro',
+  chassisColor = '#0F172A',
+  strapColor = '#1E293B',
+  accentColor = '#7C3AED',
+  faceId = 'minimal',
+  widgetId = 'heartRate',
+  widgetState = {},
+  autoRotate = true,
+} = {}) {
+  const sceneRef = useRef(null);
+  const cameraRef = useRef(null);
+  const rendererRef = useRef(null);
+  const modelGroupRef = useRef(null);
+  const textureWrapperRef = useRef(null);
+  const animFrameIdRef = useRef(null);
+
+  // Rotation & zoom state refs for smooth damping
+  const targetRotationRef = useRef({ x: 0.1, y: -0.3 });
+  const currentRotationRef = useRef({ x: 0.1, y: -0.3 });
+  const targetDistanceRef = useRef(DEFAULT_DISTANCE);
+  const currentDistanceRef = useRef(DEFAULT_DISTANCE);
+  const isDraggingRef = useRef(false);
+  const lastPointerRef = useRef({ x: 0, y: 0 });
+  const autoRotateRef = useRef(autoRotate);
+
+  // Keep autoRotateRef in sync
+  useEffect(() => {
+    autoRotateRef.current = autoRotate;
+  }, [autoRotate]);
+
+  // Update canvas texture on face or widget changes
+  useEffect(() => {
+    if (textureWrapperRef.current) {
+      textureWrapperRef.current.update({
+        faceId,
+        widgetId,
+        widgetState,
+      });
+    }
+  }, [faceId, widgetId, widgetState]);
+
+  // Update materials when colors change
+  useEffect(() => {
+    if (modelGroupRef.current) {
+      updateModelColors(modelGroupRef.current, {
+        chassisColor,
+        strapColor,
+        accentColor,
+      });
+    }
+  }, [chassisColor, strapColor, accentColor]);
+
+  // Rebuild model when modelType or tier changes
+  useEffect(() => {
+    if (!sceneRef.current || !textureWrapperRef.current) return;
+
+    // Dispose old model
+    if (modelGroupRef.current) {
+      sceneRef.current.remove(modelGroupRef.current);
+      disposeModel(modelGroupRef.current);
+    }
+
+    // Build new model
+    const builder = modelType === 'band' ? createBandModel : createWatchModel;
+    const newModel = builder({
+      chassisColor,
+      strapColor,
+      accentColor,
+      screenTexture: textureWrapperRef.current.texture,
+      tier,
+    });
+
+    modelGroupRef.current = newModel;
+    sceneRef.current.add(newModel);
+  }, [modelType, tier]);
+
+  // Reset view to default front-facing orientation
+  const resetView = useCallback(() => {
+    targetRotationRef.current = { x: 0.05, y: 0 };
+    targetDistanceRef.current = DEFAULT_DISTANCE;
+  }, []);
+
+  // Zoom controls
+  const zoomIn = useCallback(() => {
+    targetDistanceRef.current = Math.max(MIN_DISTANCE, targetDistanceRef.current - 1.2);
+  }, []);
+
+  const zoomOut = useCallback(() => {
+    targetDistanceRef.current = Math.min(MAX_DISTANCE, targetDistanceRef.current + 1.2);
+  }, []);
+
+  // Initialize Three.js scene, lighting, camera, renderer, and events
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    // 1. Scene
+    const scene = new THREE.Scene();
+    sceneRef.current = scene;
+
+    // 2. Camera
+    const width = container.clientWidth || 600;
+    const height = container.clientHeight || 500;
+    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 100);
+    camera.position.set(0, 0, DEFAULT_DISTANCE);
+    cameraRef.current = camera;
+
+    // 3. Lighting
+    const ambientLight = new THREE.HemisphereLight(0xffffff, 0x1e293b, 1.2);
+    scene.add(ambientLight);
+
+    const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
+    keyLight.position.set(5, 8, 6);
+    scene.add(keyLight);
+
+    const fillLight = new THREE.DirectionalLight(0x06b6d4, 0.8);
+    fillLight.position.set(-6, -2, 4);
+    scene.add(fillLight);
+
+    const rimLight = new THREE.DirectionalLight(0x7c3aed, 1.0);
+    rimLight.position.set(0, 6, -5);
+    scene.add(rimLight);
+
+    // 4. Dynamic Watch Face Texture
+    const textureWrapper = createWatchCanvasTexture({
+      faceId,
+      widgetId,
+      widgetState,
+    });
+    textureWrapperRef.current = textureWrapper;
+
+    // 5. Initial Procedural Model
+    const builder = modelType === 'band' ? createBandModel : createWatchModel;
+    const modelGroup = builder({
+      chassisColor,
+      strapColor,
+      accentColor,
+      screenTexture: textureWrapper.texture,
+      tier,
+    });
+    modelGroupRef.current = modelGroup;
+    scene.add(modelGroup);
+
+    // 6. Renderer
+    const renderer = new THREE.WebGLRenderer({
+      antialias: true,
+      alpha: true,
+      powerPreference: 'high-performance',
+    });
+    renderer.setSize(width, height);
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+    renderer.toneMapping = THREE.ACESFilmicToneMapping;
+    renderer.toneMappingExposure = 1.15;
+    rendererRef.current = renderer;
+
+    container.appendChild(renderer.domElement);
+
+    // 7. Interaction Handlers
+    const onPointerDown = (e) => {
+      isDraggingRef.current = true;
+      lastPointerRef.current = { x: e.clientX, y: e.clientY };
+    };
+
+    const onPointerMove = (e) => {
+      if (!isDraggingRef.current) return;
+      const deltaX = e.clientX - lastPointerRef.current.x;
+      const deltaY = e.clientY - lastPointerRef.current.y;
+      lastPointerRef.current = { x: e.clientX, y: e.clientY };
+
+      targetRotationRef.current.y += deltaX * 0.008;
+      targetRotationRef.current.x = Math.max(
+        -Math.PI / 2.6,
+        Math.min(Math.PI / 2.6, targetRotationRef.current.x + deltaY * 0.008)
+      );
+    };
+
+    const onPointerUp = () => {
+      isDraggingRef.current = false;
+    };
+
+    // Touch controls
+    const onTouchStart = (e) => {
+      if (e.touches.length === 1) {
+        isDraggingRef.current = true;
+        lastPointerRef.current = { x: e.touches[0].clientX, y: e.touches[0].clientY };
+      }
+    };
+
+    const onTouchMove = (e) => {
+      if (!isDraggingRef.current || e.touches.length !== 1) return;
+      const deltaX = e.touches[0].clientX - lastPointerRef.current.x;
+      const deltaY = e.touches[0].clientY - lastPointerRef.current.y;
+      lastPointerRef.current = { x: e.touches[0].clientX, y: e.touches[0].clientY };
+
+      targetRotationRef.current.y += deltaX * 0.01;
+      targetRotationRef.current.x = Math.max(
+        -Math.PI / 2.6,
+        Math.min(Math.PI / 2.6, targetRotationRef.current.x + deltaY * 0.01)
+      );
+    };
+
+    const onTouchEnd = () => {
+      isDraggingRef.current = false;
+    };
+
+    // Wheel zoom
+    const onWheel = (e) => {
+      e.preventDefault();
+      const zoomDelta = e.deltaY * 0.005;
+      targetDistanceRef.current = Math.max(
+        MIN_DISTANCE,
+        Math.min(MAX_DISTANCE, targetDistanceRef.current + zoomDelta)
+      );
+    };
+
+    // Resize handler
+    const onResize = () => {
+      if (!container || !renderer || !camera) return;
+      const w = container.clientWidth;
+      const h = container.clientHeight;
+      if (w === 0 || h === 0) return;
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      renderer.setSize(w, h);
+    };
+
+    const domElement = renderer.domElement;
+    domElement.addEventListener('pointerdown', onPointerDown);
+    window.addEventListener('pointermove', onPointerMove);
+    window.addEventListener('pointerup', onPointerUp);
+    domElement.addEventListener('touchstart', onTouchStart, { passive: true });
+    window.addEventListener('touchmove', onTouchMove, { passive: true });
+    window.addEventListener('touchend', onTouchEnd);
+    domElement.addEventListener('wheel', onWheel, { passive: false });
+    window.addEventListener('resize', onResize);
+
+    // 8. Animation & Render Loop
+    let lastTime = performance.now();
+    let tickCounter = 0;
+
+    const animate = (currentTime) => {
+      animFrameIdRef.current = requestAnimationFrame(animate);
+
+      const deltaTime = Math.min((currentTime - lastTime) / 1000, 0.1);
+      lastTime = currentTime;
+
+      // Auto-spin turntable (1.5 RPM) when not user-dragging
+      if (autoRotateRef.current && !isDraggingRef.current) {
+        targetRotationRef.current.y += AUTO_ROTATE_SPEED * deltaTime;
+      }
+
+      // Smooth inertia damping for rotation
+      currentRotationRef.current.x += (targetRotationRef.current.x - currentRotationRef.current.x) * DAMPING;
+      currentRotationRef.current.y += (targetRotationRef.current.y - currentRotationRef.current.y) * DAMPING;
+
+      if (modelGroupRef.current) {
+        modelGroupRef.current.rotation.x = currentRotationRef.current.x;
+        modelGroupRef.current.rotation.y = currentRotationRef.current.y;
+      }
+
+      // Smooth zoom damping
+      currentDistanceRef.current += (targetDistanceRef.current - currentDistanceRef.current) * DAMPING;
+      camera.position.z = currentDistanceRef.current;
+
+      // Update watch face time (hands / seconds) every 4 frames for optimal 60fps rendering
+      tickCounter++;
+      if (tickCounter % 4 === 0 && textureWrapperRef.current) {
+        textureWrapperRef.current.update({ time: new Date() });
+      }
+
+      renderer.render(scene, camera);
+    };
+
+    animFrameIdRef.current = requestAnimationFrame(animate);
+
+    // 9. Cleanup on Unmount
+    return () => {
+      if (animFrameIdRef.current) {
+        cancelAnimationFrame(animFrameIdRef.current);
+      }
+
+      domElement.removeEventListener('pointerdown', onPointerDown);
+      window.removeEventListener('pointermove', onPointerMove);
+      window.removeEventListener('pointerup', onPointerUp);
+      domElement.removeEventListener('touchstart', onTouchStart);
+      window.removeEventListener('touchmove', onTouchMove);
+      window.removeEventListener('touchend', onTouchEnd);
+      domElement.removeEventListener('wheel', onWheel);
+      window.removeEventListener('resize', onResize);
+
+      if (modelGroupRef.current) {
+        scene.remove(modelGroupRef.current);
+        disposeModel(modelGroupRef.current);
+      }
+
+      if (textureWrapperRef.current) {
+        textureWrapperRef.current.dispose();
+      }
+
+      renderer.dispose();
+      if (domElement.parentElement) {
+        domElement.parentElement.removeChild(domElement);
+      }
+    };
+  }, [containerRef]);
+
+  return {
+    resetView,
+    zoomIn,
+    zoomOut,
+  };
+}

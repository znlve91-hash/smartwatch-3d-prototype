+    name: 'Glacier Cyan',
+    hex: '#06B6D4',
+    chassisHex: '#0891B2',
+    strapHex: '#06B6D4',
+  },
+  {
+    id: 'starlight-silver',
+    name: 'Starlight Silver',
+    hex: '#CBD5E1',
